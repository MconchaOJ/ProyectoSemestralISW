# =============================================================================
# .env.docker.example - Variables de entorno para docker-compose
#
# Copia este archivo como .env.docker y completa los valores:
#   cp .env.docker.example .env.docker
#
# NUNCA subas .env.docker al repositorio (ya está en .gitignore).
# =============================================================================

# ── MySQL ─────────────────────────────────────────────────────────────────────
# Contraseña del usuario root de MySQL (solo la usa el contenedor internamente)
ISW_DB_ROOT_PASSWORD=rootdev2026

# Usuario y contraseña de la aplicación (creados automáticamente por MySQL al iniciar)
ISW_DB_USER=isw_app
ISW_DB_PASSWORD=devpass2026

# Puerto en el HOST para acceder a MySQL (3307 por defecto para no chocar con MySQL local)
ISW_DB_PORT_HOST=3307

# ── Backend ───────────────────────────────────────────────────────────────────
# Puerto en el HOST para acceder a la API (8080 por defecto)
ISW_BACKEND_PORT=8080

# Secreto JWT (opcional en desarrollo; si se deja vacío, se genera uno temporal al arrancar)
ISW_JWT_SECRET=

# Perfil de Spring Boot (vacío = perfil por defecto para desarrollo)
SPRING_PROFILES_ACTIVE=

# ── APIs externas (placeholders) ──────────────────────────────────────────────
# Descomenta y completa si tu rama necesita integración con APIs externas.
# OPENAI_API_KEY=sk-...
# CHATBOT_API_URL=https://api.example.com/v1/chat
# CHATBOT_API_KEY=
