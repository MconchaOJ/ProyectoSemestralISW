      <bpmndi:BPMNShape id="Leg_1_di" bpmnElement="Leg_1"><dc:Bounds x="240" y="530" width="250" height="58" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_1_Task_Planificar_di" bpmnElement="Flow_Start_1_Task_Planificar"><di:waypoint x="288" y="115" /><di:waypoint x="380" y="115" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_Planificar_Task_RevisarGuia_di" bpmnElement="Flow_Task_Planificar_Task_RevisarGuia"><di:waypoint x="445" y="155" /><di:waypoint x="445" y="225" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_RevisarGuia_Gw_Mejoras_di" bpmnElement="Flow_Task_RevisarGuia_Gw_Mejoras"><di:waypoint x="510" y="265" /><di:waypoint x="595" y="265" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gw_Mejoras_Task_Planificar_di" bpmnElement="Flow_Gw_Mejoras_Task_Planificar"><di:waypoint x="620" y="240" /><di:waypoint x="620" y="48" /><di:waypoint x="405" y="48" /><di:waypoint x="405" y="75" /><bpmndi:BPMNLabel><dc:Bounds x="525" y="196" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gw_Mejoras_Task_PresentarCurso_di" bpmnElement="Flow_Gw_Mejoras_Task_PresentarCurso"><di:waypoint x="645" y="265" /><di:waypoint x="688" y="265" /><di:waypoint x="688" y="115" /><di:waypoint x="730" y="115" /><bpmndi:BPMNLabel><dc:Bounds x="650" y="246" width="28" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_PresentarCurso_Task_Autorizar_di" bpmnElement="Flow_Task_PresentarCurso_Task_Autorizar"><di:waypoint x="795" y="155" /><di:waypoint x="795" y="375" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_Autorizar_Gw_Autoriza_di" bpmnElement="Flow_Task_Autorizar_Gw_Autoriza"><di:waypoint x="860" y="415" /><di:waypoint x="945" y="415" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gw_Autoriza_Task_Planificar_di" bpmnElement="Flow_Gw_Autoriza_Task_Planificar"><di:waypoint x="970" y="390" /><di:waypoint x="970" y="56" /><di:waypoint x="445" y="56" /><di:waypoint x="445" y="75" /><bpmndi:BPMNLabel><dc:Bounds x="866" y="196" width="100" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gw_Autoriza_Task_Clase_di" bpmnElement="Flow_Gw_Autoriza_Task_Clase"><di:waypoint x="995" y="415" /><di:waypoint x="1038" y="415" /><di:waypoint x="1038" y="115" /><di:waypoint x="1080" y="115" /><bpmndi:BPMNLabel><dc:Bounds x="1000" y="396" width="28" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_Clase_Task_PautaPapel_di" bpmnElement="Flow_Task_Clase_Task_PautaPapel"><di:waypoint x="1145" y="155" /><di:waypoint x="1145" y="225" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_PautaPapel_Task_Firmar_di" bpmnElement="Flow_Task_PautaPapel_Task_Firmar"><di:waypoint x="1210" y="265" /><di:waypoint x="1255" y="265" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_Firmar_Task_Transcribir_di" bpmnElement="Flow_Task_Firmar_Task_Transcribir"><di:waypoint x="1320" y="305" /><di:waypoint x="1320" y="375" /></bpmndi:BPMNEdge>
