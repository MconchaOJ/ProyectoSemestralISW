      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="252" y="97" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="215" y="137" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
