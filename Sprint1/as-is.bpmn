      <bpmndi:BPMNShape id="Gw_Autoriza_di" bpmnElement="Gw_Autoriza" isMarkerVisible="true"><dc:Bounds x="945" y="390" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="915" y="444" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Clase_di" bpmnElement="Task_Clase"><dc:Bounds x="1080" y="75" width="130" height="80" /></bpmndi:BPMNShape>
