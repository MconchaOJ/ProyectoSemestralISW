# =============================================================================
# .env.example - Plantilla de configuración. NO contiene datos reales.
#
# El proyecto guarda las claves SOLO en variables de entorno del sistema (nunca en
# archivos del repositorio). Este archivo solo documenta los nombres y el formato.
# Si tu herramienta necesita un archivo, copia esta plantilla como ".env" y completa
# los valores: ".env" está en .gitignore y no se sube.
# =============================================================================

# --- Conexión a MySQL (la usa la aplicación Spring Boot) ---
ISW_DB_HOST=localhost
ISW_DB_PORT=3306
ISW_DB_USER=isw_app
# Clave del usuario isw_app. La genera db/bd.ps1 la primera vez y la guarda como
# variable de entorno de usuario de Windows. Para leerla: $env:ISW_DB_PASSWORD
ISW_DB_PASSWORD=<clave-del-usuario-isw_app>

# --- Solo para db/bd.ps1 (crear la base y el usuario). La aplicación NO la usa ---
ISW_DB_ROOT_USER=root
ISW_DB_ROOT_PASSWORD=<clave-de-root-de-mysql>

# --- Seguridad de la API (HU-01, token de acceso). OPCIONAL ---
# Texto largo y aleatorio (32 caracteres o más). Cada persona/entorno debe usar el suyo.
# Si no existe, la aplicación genera uno al arrancar y los tokens dejan de valer al reiniciarla.
ISW_JWT_SECRET=<cadena-aleatoria-larga>

# --- Chatbot de retroalimentación (HU-15): clave de la API de Groq. OPCIONAL ---
# Se crea en https://console.groq.com/keys (capa gratuita). Si no existe, la aplicación arranca
# igual y el chatbot responde "no está configurado" (503); el resto del sistema no se ve afectado.
# Las pruebas automáticas (mvn clean package) NO la usan: el modelo se reemplaza por un doble.
ISW_GROQ_API_KEY=<clave-de-groq>

# -----------------------------------------------------------------------------
# Cómo definir una variable en Windows (PowerShell, sin dejar la clave en el historial):
#   $s = Read-Host 'Clave de root de MySQL' -AsSecureString
#   $clave = [Runtime.InteropServices.Marshal]::PtrToStringAuto([Runtime.InteropServices.Marshal]::SecureStringToBSTR($s))
#   [Environment]::SetEnvironmentVariable('ISW_DB_ROOT_PASSWORD', $clave, 'User')
# Después abre una terminal nueva para que la variable quede disponible.
# -----------------------------------------------------------------------------
